<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>interop-gen10</AssemblyName>
    <!-- Dev Cpp2IL family (parses metadata v108) -->
    <Dev>C:\tools\Cpp2IL-dev-bin</Dev>
    <!-- BepInEx be.791 core (the generator the game itself ships) -->
    <BepCore>C:\Program Files (x86)\Steam\steamapps\common\Moon Sweepers\BepInEx\core</BepCore>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Cpp2IL.Core"><HintPath>$(Dev)\Cpp2IL.Core.dll</HintPath></Reference>
    <Reference Include="LibCpp2IL"><HintPath>$(Dev)\LibCpp2IL.dll</HintPath></Reference>
    <Reference Include="AsmResolver"><HintPath>$(Dev)\AsmResolver.dll</HintPath></Reference>
    <Reference Include="AsmResolver.DotNet"><HintPath>$(Dev)\AsmResolver.DotNet.dll</HintPath></Reference>
    <Reference Include="AsmResolver.PE"><HintPath>$(Dev)\AsmResolver.PE.dll</HintPath></Reference>
    <Reference Include="AsmResolver.PE.File"><HintPath>$(Dev)\AsmResolver.PE.File.dll</HintPath></Reference>
    <Reference Include="AssetRipper.Primitives"><HintPath>$(Dev)\AssetRipper.Primitives.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Generator"><HintPath>$(BepCore)\Il2CppInterop.Generator.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(BepCore)\Il2CppInterop.Common.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepCore)\Il2CppInterop.Runtime.dll</HintPath></Reference>
  </ItemGroup>
</Project>
